APP_ENV=development
COMPOSE_PROFILES=development
POSTGRES_PASSWORD=replace-with-random-value
APP_DB_PASSWORD=replace-with-random-value
WORKER_DB_PASSWORD=replace-with-random-value
RABBITMQ_USER=selfmail
RABBITMQ_PASSWORD=replace-with-random-value
REDIS_PASSWORD=replace-with-random-value
MASTER_KEY=replace-with-base64-32-byte-key
SMTP_HOSTNAME=mail.example.test
BOUNCE_DOMAIN=bounce.example.test
PUBLIC_URL=http://localhost:18080
ALLOW_PLAIN_SMTP=true
ALLOW_UNVERIFIED_DOMAINS=true
ALLOW_PRIVATE_WEBHOOKS=true
WORKER_CONCURRENCY=2
JOURNAL_MAX_BYTES=10737418240
MAX_WIRE_BYTES=10485760
# Internal metrics use port 9090 and are never exposed on the host.
